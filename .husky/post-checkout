prev_head="$1"
new_head="$2"
is_branch_checkout="$3"

new_branch=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ "$is_branch_checkout" = "1" ] && [ "$new_branch" = "develop" ] && (: < /dev/tty) 2>/dev/null; then
  printf "Pull the latest changes from develop? (y/N) " > /dev/tty
  read -r answer < /dev/tty
  case "$answer" in
    [Yy]|[Yy][Ee][Ss])
      git pull
      ;;
  esac
fi
